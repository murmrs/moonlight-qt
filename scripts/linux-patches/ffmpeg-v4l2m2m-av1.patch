diff --git a/libavcodec/v4l2_fmt.c b/libavcodec/v4l2_fmt.c
index 6df47e3..901abdd 100644
--- a/libavcodec/v4l2_fmt.c
+++ b/libavcodec/v4l2_fmt.c
@@ -26,6 +26,11 @@
 #include "v4l2_fmt.h"
 
 #define V4L2_FMT(x) V4L2_PIX_FMT_##x
+
+/* Stateful AV1 bitstream (one temporal unit per buffer), added in Linux 7.0 */
+#ifndef V4L2_PIX_FMT_AV1
+#define V4L2_PIX_FMT_AV1 v4l2_fourcc('A', 'V', '0', '1')
+#endif
 #define AV_CODEC(x) AV_CODEC_ID_##x
 #define AV_FMT(x)   AV_PIX_FMT_##x
 
@@ -107,6 +112,7 @@ static const struct fmt_conversion {
 #ifdef V4L2_PIX_FMT_VC1_ANNEX_G
     { AV_FMT(NONE),        AV_CODEC(VC1),         V4L2_FMT(VC1_ANNEX_G) },
 #endif
+    { AV_FMT(NONE),        AV_CODEC(AV1),         V4L2_FMT(AV1) },
 };
 
 uint32_t ff_v4l2_format_avcodec_to_v4l2(enum AVCodecID avcodec)
