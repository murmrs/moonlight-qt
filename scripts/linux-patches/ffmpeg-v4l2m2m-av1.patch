Add an av1_v4l2m2m decoder for stateful V4L2 AV1 decoders.

Linux 7.0 added V4L2_PIX_FMT_AV1 ('AV01', one temporal unit per buffer) for
stateful decoders, and the Qualcomm iris driver exposes it on SM8550, SM8650
and SM8750. FFmpeg's generic V4L2 M2M wrapper handles it without
codec-specific code, so this only registers the codec and maps the fourcc.
The fourcc is defined locally because older kernel headers lack it.

Applies to cgutman/FFmpeg f116128cafb244bc0f809d0285932ced0471268d.

diff --git a/configure b/configure
index 559e543..a663750 100755
--- a/configure
+++ b/configure
@@ -3573,6 +3573,7 @@ av1_cuvid_decoder_deps="cuvid CUVIDAV1PICPARAMS"
 av1_d3d12va_encoder_deps="d3d12va d3d12va_av1_headers"
 av1_d3d12va_encoder_select="cbs_av1 d3d12va_encode"
 av1_mediacodec_decoder_deps="mediacodec"
+av1_v4l2m2m_decoder_deps="v4l2_m2m av1_v4l2_m2m"
 av1_mediacodec_encoder_deps="mediacodec"
 av1_mediacodec_encoder_select="extract_extradata_bsf"
 av1_mf_encoder_deps="mediafoundation"
@@ -7605,6 +7606,7 @@ if enabled v4l2_m2m; then
     check_cc h264_v4l2_m2m linux/videodev2.h "int i = V4L2_PIX_FMT_H264;"
     check_cc vp8_v4l2_m2m linux/videodev2.h "int i = V4L2_PIX_FMT_VP8;"
     check_cc vp9_v4l2_m2m linux/videodev2.h "int i = V4L2_PIX_FMT_VP9;"
+    check_cc av1_v4l2_m2m linux/videodev2.h "int i = v4l2_fourcc('A', 'V', '0', '1');"
 fi
 
 if enabled v4l2_request; then
